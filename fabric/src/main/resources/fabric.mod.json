{
  "schemaVersion": 1,
  "id": "vynmap",
  "version": "${version}",
  "name": "Vynmap",
  "description": "An addon for integration between Dynmap and VS2!",
  "authors": [
    "You!"
  ],
  "contact": {
    "homepage": "https://valkyrienskies.org/",
    "sources": "https://github.com/ValkyrienSkies/Eureka"
  },
  "license": "Apache-2.0",
  "icon": "assets/vynmap/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.techtastic.vynmap.fabric.VynmapModFabric"
    ],
    "client": [
      "io.github.techtastic.vynmap.fabric.VynmapModFabric${'$'}Client"
    ],
    "preLaunch": [
      "io.github.techtastic.vynmap.fabric.ValkyrienPreLaunch"
    ]
  },
  "mixins": [
    "vynmap-common.mixins.json",
    "vynmap.mixins.json"
  ],
  "depends": {
    "minecraft": ">=1.18.2",
    "valkyrienskies": ">=${vs2_version}",
    "fabricloader": ">=0.14.21"
  }
}